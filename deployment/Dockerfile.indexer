# Dockerfile for indexing workload
FROM node:lts

RUN apt-get update \
 && apt-get install -y \
      python3 \
      g++ \
      make \
      curl \
      unzip \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

WORKDIR /app

COPY package.json ./
RUN bun install --no-cache

COPY src/indexer.ts ./src/indexer.ts
COPY src/chunker.ts ./src/chunker.ts

ENV NODE_OPTIONS="--max-old-space-size=4096"

# Create directory for index output
RUN mkdir -p /app/vectra_index

# Default command runs the indexer
# Arguments should be passed at runtime via k8s args
CMD ["bun", "run", "src/indexer.ts"]